# ── Algolotl backend config (all optional; sensible dev defaults) ──
ALGO_ENVIRONMENT=development
# REQUIRED in production — a long random string (openssl rand -hex 32):
ALGO_SECRET_KEY=change-me-to-a-64-char-random-hex
# JWT lifetime (minutes):
ALGO_ACCESS_TOKEN_TTL_MIN=10080
# CORS (comma-separated). Use your real domain in prod, e.g. https://algolotl.dev
ALGO_CORS_ORIGINS=*
# Where users+progress JSON lives (swap for a DB later):
ALGO_DATA_DIR=./_store
# Optional: plug a real LLM for the AI tutor (works without it — offline tutor):
ALGO_OPENAI_API_KEY=
ALGO_OPENAI_BASE_URL=https://api.openai.com/v1
ALGO_OPENAI_MODEL=gpt-4o-mini
# Optional: Google OAuth (see README):
ALGO_GOOGLE_CLIENT_ID=
ALGO_GOOGLE_CLIENT_SECRET=
